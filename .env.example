# Copy this file to .env and fill in real values.
# Never commit the .env file itself.
#
# Referenced from config/users.json via {{env:VAR}} tokens.
ADMIN_PASSWORD=admin123
USER_PASSWORD=Mix@123!@#

# Only needed if you enable Burp Suite Professional integration:
# 1. In Burp: User options -> Misc -> REST API -> enable it, bind to
#    0.0.0.0 (not 127.0.0.1) if stof runs on a different machine than
#    Burp, and copy the generated API key below.
# 2. In config/config.json, set burp.enabled=true and
#    burp.api_key="{{env:BURP_API_KEY}}" (it ships as "" so a normal
#    `stof test` run works without this being set at all).
