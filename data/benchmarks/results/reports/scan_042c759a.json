      },
      "user_role": "admin",
      "request_raw": "GET http://127.0.0.1:3001/#/ (anonymous, pre-login) vs. a freshly-authenticated session for role 'admin'",
      "response_raw": "cookie 'cookieconsent_status': httpOnly=False, secure=False, sameSite='Lax'",
      "evidence_refs": [
        "data/benchmarks/results/evidence/042c759a/auth-9061a6ff-9c28-42a2-9515-2ad011e26caf/request.txt",
        "data/benchmarks/results/evidence/042c759a/auth-9061a6ff-9c28-42a2-9515-2ad011e26caf/response.txt",
