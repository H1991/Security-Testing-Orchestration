      },
      "user_role": "admin",
      "request_raw": "GET http://127.0.0.1:3001/#/ using the FIRST of two independent logins' session cookie for role 'admin', after the second login completed",
      "response_raw": "HTTP 200, 9393 bytes (post-second-login replay)",
      "evidence_refs": [],
      "description": "The session cookie captured from a first login for role 'admin' still authenticates against 'http://127.0.0.1:3001/#/' (HTTP 200) after a second, independent login for the same role has completed -- the server does not revoke prior sessions when a new one is established.",
      "recommendation": "Either revoke prior sessions when a new authentication event occurs for the same account, or provide the user a way to view and remotely terminate concurrent sessions, per the OWASP Session Management Cheat Sheet.",
      "discovered_at": "2026-09-03T13:12:36.027616+00:00",
      "scanner_source": "stof",
      "cwe": "CWE-287 - Improper Authentication",
      "owasp_category": "A07:2025 - Identification and Authentication Failures",
      "technique_id": null
    },
