      },
      "user_role": "admin",
      "request_raw": "GET http://127.0.0.1:3001/#/ (anonymous, pre-login) vs. a freshly-authenticated session for role 'admin'",
      "response_raw": "cookie 'continueCode': httpOnly=False, secure=False, sameSite='Lax'",
      "evidence_refs": [
        "data/benchmarks/results/evidence/11f4dab5/auth-20ed88c2-c48d-491c-b927-956343c35193/request.txt",
