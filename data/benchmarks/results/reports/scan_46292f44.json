      "vuln_type": "Session Not Bound To Client Fingerprint (Hijacking Risk)",
      "severity": "Low",
      "cvss_score": 3.7,
      "endpoint": {
        "url": "http://127.0.0.1:3001/#/",
        "method": "GET",
        "endpoint_type": "api",
        "parameters": [],
        "param_locations": {},
        "parameter_values": {},
        "auth_required": false,
        "discovered_at": "2026-09-03T14:04:19.301891+00:00"
      },
      "user_role": "admin",
      "request_raw": "GET http://127.0.0.1:3001/#/ using role 'admin''s session cookie, with a completely different User-Agent (desktop login vs. mobile replay)",
      "response_raw": "HTTP 200, 9393 bytes",
      "evidence_refs": [],
      "description": "The session cookie for role 'admin' is accepted from a client presenting a completely different User-Agent than the one that logged in -- the session is not bound to any client fingerprint, so a stolen cookie alone (no other client secret) is sufficient to hijack the session from a different device/browser.",
      "recommendation": "This is a defense-in-depth gap, not a standalone vulnerability (per-request client-binding is unusual and has real usability tradeoffs) -- consider it alongside session lifetime/rotation controls, not as a required fix on its own.",
      "discovered_at": "2026-09-03T14:04:19.301933+00:00",
      "scanner_source": "stof"
    },
