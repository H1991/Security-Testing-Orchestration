        "param_locations": {},
        "parameter_values": {},
        "auth_required": false,
        "discovered_at": "2026-09-03T14:04:16.557785+00:00"
      },
      "user_role": "admin",
      "request_raw": "GET http://127.0.0.1:3001/#/ (authenticated, role 'admin')",
      "response_raw": "Content-Type: text/html; charset=UTF-8\nCache-Control: public, max-age=0",
      "evidence_refs": [],
      "description": "'http://127.0.0.1:3001/#/' authenticated response has no Cache-Control: no-store/no-cache directive -- a shared or public browser's back-button/disk cache can replay this authenticated page's content even after the user has logged out.",
      "recommendation": "Set Cache-Control: no-store (and Pragma: no-cache for older HTTP/1.0 caches) on every authenticated response.",
      "discovered_at": "2026-09-03T14:04:16.557839+00:00",
      "scanner_source": "stof"
    },
