        "auth_required": false,
        "discovered_at": "2026-09-03T14:04:04.972848+00:00"
      },
      "user_role": "admin",
      "request_raw": "GET http://127.0.0.1:3001/#/ (anonymous, pre-login) vs. a freshly-authenticated session for role 'admin'",
      "response_raw": "cookie 'cookieconsent_status': httpOnly=False, secure=False, sameSite='Lax'",
      "evidence_refs": [
        "data/benchmarks/results/evidence/46292f44/auth-7cfb6d96-24dd-471c-8e88-4269d976f591/request.txt",
        "data/benchmarks/results/evidence/46292f44/auth-7cfb6d96-24dd-471c-8e88-4269d976f591/response.txt",
        "data/benchmarks/results/evidence/46292f44/auth-7cfb6d96-24dd-471c-8e88-4269d976f591/request_response.png"
      ],
      "description": "cookie 'cookieconsent_status' is missing the HttpOnly flag -- identified as a session/auth cookie because it was newly issued or changed value across the login boundary for role 'admin'.",
      "recommendation": "Set HttpOnly and Secure on every session/auth cookie, and never set SameSite=None without also setting Secure.",
      "discovered_at": "2026-09-03T14:04:04.972879+00:00",
      "scanner_source": "stof"
    },
    {
