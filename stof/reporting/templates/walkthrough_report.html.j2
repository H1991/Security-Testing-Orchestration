<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>STOF Walkthrough Report{% if scan_metadata.target %} — {{ scan_metadata.target }}{% endif %}</title>
<style>
  :root {
    --critical: #c00000; --high: #e97132; --medium: #ffc000; --low: #70ad47; --info: #8ea9db;
    --bg: #f4f6f8; --card: #ffffff; --ink: #1a2433; --muted: #5b6b7c; --border: #e1e6eb;
    --teal: #0f766e; --teal-ink: #f0fdfa;
  }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: -apple-system, "Segoe UI", Roboto, Arial, sans-serif; background: var(--bg); color: var(--ink); }
  header { background: #0b3d3a; background: linear-gradient(135deg, #0b3d3a 0%, #1f4e78 100%); color: #fff; padding: 28px 32px; }
  header h1 { margin: 0 0 6px; font-size: 22px; }
  header .meta { color: #d8f3ee; font-size: 13px; }
  header .subtitle { color: #d8f3ee; font-size: 13px; margin-top: 4px; }
  main { max-width: 980px; margin: 0 auto; padding: 24px 20px 60px; }
  .finding { background: var(--card); border: 1px solid var(--border); border-left: 6px solid var(--border); border-radius: 8px; padding: 22px 24px; margin-bottom: 26px; }
  .finding.sev-critical { border-left-color: var(--critical); }
  .finding.sev-high { border-left-color: var(--high); }
  .finding.sev-medium { border-left-color: var(--medium); }
  .finding.sev-low { border-left-color: var(--low); }
  .finding.sev-info { border-left-color: var(--info); }
  .finding-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .finding-head h2 { font-size: 18px; margin: 0; }
  .finding-url { color: var(--muted); font-size: 13px; margin: 6px 0 0; word-break: break-word; }
  .badge { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 11px; font-weight: 700; color: #fff; text-transform: uppercase; letter-spacing: .03em; }
  .badge.sev-critical { background: var(--critical); }
  .badge.sev-high { background: var(--high); }
  .badge.sev-medium { background: var(--medium); color: #4d3800; }
  .badge.sev-low { background: var(--low); }
  .badge.sev-info { background: var(--info); }
  .tc-id { color: var(--muted); font-size: 11.5px; font-family: monospace; }
  .steps { margin-top: 18px; display: flex; flex-direction: column; gap: 16px; }
  .step { display: flex; gap: 14px; align-items: flex-start; }
  .step-num { flex: 0 0 28px; height: 28px; border-radius: 50%; background: var(--teal); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; }
  .step-body { flex: 1 1 auto; min-width: 0; }
  .step-caption { font-size: 14px; margin: 0 0 4px; }
  .step-detail { font-size: 12.5px; color: var(--muted); background: #f4f6f8; border: 1px solid var(--border); border-radius: 4px; padding: 4px 8px; margin: 0 0 8px; display: inline-block; word-break: break-word; font-family: monospace; }
  .step-shot a { display: block; margin-top: 6px; }
  .step-shot img { max-width: 100%; width: 100%; max-height: 560px; object-fit: contain; object-position: top left; background: #fff; border: 1px solid var(--border); border-radius: 6px; display: block; cursor: zoom-in; }
  .step-shot .no-shot { font-size: 12px; color: var(--muted); font-style: italic; }
  .build-error { background: #fdecea; border: 1px solid var(--critical); color: #7a1f1f; border-radius: 6px; padding: 10px 14px; font-size: 13px; margin-top: 16px; }
  .facts { margin-top: 18px; display: grid; grid-template-columns: 1fr; gap: 10px; }
  .fact h4 { margin: 0 0 4px; font-size: 12px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); }
  .fact p { margin: 0; font-size: 13.5px; }
  .empty { text-align: center; color: var(--muted); padding: 60px 0; }
  footer { text-align: center; color: var(--muted); font-size: 12px; padding: 20px; }
</style>
</head>
<body>
<header>
  <h1>STOF Walkthrough Report</h1>
  <div class="meta">
    {% if scan_metadata.target %}Target: {{ scan_metadata.target }} &nbsp;·&nbsp; {% endif %}
    {% if scan_metadata.scan_id %}Scan ID: {{ scan_metadata.scan_id }} &nbsp;·&nbsp; {% endif %}
    Generated: {{ generated_at }}
  </div>
  <div class="subtitle">A click-by-click, screenshot-backed reproduction guide for each confirmed finding. No raw HTTP request/response data is shown here — see the technical report for that.</div>
</header>
<main>
  {% if walkthroughs %}
    {% for w in walkthroughs %}
    <article class="finding sev-{{ w.severity | lower }}">
      <div class="finding-head">
        <h2>{{ w.title }}</h2>
        <span class="badge sev-{{ w.severity | lower }}">{{ w.severity }}</span>
      </div>
      <div class="tc-id">{{ w.tc_id }}</div>
      <p class="finding-url">{{ w.endpoint_url }}</p>

      {% if w.steps %}
      <div class="steps">
        {% for s in w.steps %}
        <div class="step">
          <div class="step-num">{{ s.order }}</div>
          <div class="step-body">
            <p class="step-caption">{{ s.caption }}</p>
            {% if s.detail %}<div class="step-detail">{{ s.detail }}</div>{% endif %}
            <div class="step-shot">
              {% if s.screenshot_data_uri %}
              <a href="{{ s.screenshot_data_uri }}" target="_blank" rel="noopener" title="Click to open full-resolution screenshot in a new tab">
                <img src="{{ s.screenshot_data_uri }}" alt="Step {{ s.order }} screenshot for {{ w.title }}">
              </a>
              {% else %}
              <span class="no-shot">(no screenshot for this step)</span>
              {% endif %}
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
      {% endif %}

      {% if w.build_error %}
      <div class="build-error">This finding's replay couldn't be captured automatically: {{ w.build_error }}. See the technical report for the underlying evidence.</div>
      {% endif %}

      <div class="facts">
        <div class="fact">
          <h4>What this means</h4>
          <p>{{ w.impact_summary }}</p>
        </div>
        <div class="fact">
          <h4>How to fix it</h4>
          <p>{{ w.remediation }}</p>
        </div>
      </div>
    </article>
    {% endfor %}
  {% else %}
    <div class="empty">No confirmed findings to walk through in this scan.</div>
  {% endif %}
</main>
<footer>Generated by STOF — Security Testing Orchestration Framework</footer>
</body>
</html>
